{
    "name": "obsidian-dynamic-embed",
    "version": "1.1.0",
    "description": "Dynamicly interpreted inline embeds for Obsidian (https://obsidian.md)",
    "main": "main.js",
    "scripts": {
        "dev": "bun esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
        "typecheck": "tsc --noEmit -skipLibCheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint *.ts",
        "lint:fix": "eslint *.ts --fix",
        "version": "bun version-bump.mjs && git add manifest.json versions.json",
        "deploy": "bun run build && bun run scripts/deploy.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "builtin-modules": "^5.3.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.8.1",
        "eslint-plugin-obsidianmd": "^0.4.1",
        "obsidian": "^1.8.0",
        "tslib": "^2.8.0",
        "typescript": "^5.7.0",
        "vitest": "^4"
    }
}
